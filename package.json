{
  "name": "rescue-control-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:mock": "NEXT_PUBLIC_API_MOCK=1 next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "gen:assets": "tsx scripts/generate-assets.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "gen:mock-catalog": "tsx scripts/gen-mock-catalog.ts",
    "e2e:real": "playwright test --config=playwright.real.config.ts",
    "e2e:real:report": "playwright show-report playwright-report-real",
    "pretest": "pnpm gen:mock-catalog",
    "prebuild": "pnpm gen:mock-catalog"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "h3-js": "^4",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^5",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "intl-messageformat": "^12.1.2",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "vite": "^6",
    "vitest": "^3.2.7",
    "yaml": "^2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
