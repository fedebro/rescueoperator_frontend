# Backend API origin (the client appends /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000
# 1 = run against the in-browser mock backend (MSW + simulated core loop). No real backend needed.
NEXT_PUBLIC_API_MOCK=0
# Mock time multiplier (1 = realistic timing; e2e uses 12)
NEXT_PUBLIC_MOCK_SPEED=1
# Basemap. Default: OpenFreeMap public vector tiles (OpenMapTiles schema), keyless, dev only.
NEXT_PUBLIC_MAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# Production: self-hosted Protomaps PMTiles archive (Protomaps basemap schema). When set it wins over the TileJSON URL.
# e.g. https://cdn.example.com/italy.pmtiles
NEXT_PUBLIC_PMTILES_URL=
# Schema of that archive: openmaptiles (default — what infra/tiles builds) or protomaps
NEXT_PUBLIC_PMTILES_SCHEMA=openmaptiles
# Font stacks available on the glyph server (the local tile server ships Regular/Medium/Italic → set BOLD to "Noto Sans Medium")
NEXT_PUBLIC_MAP_FONT_REGULAR=Noto Sans Regular
NEXT_PUBLIC_MAP_FONT_BOLD=Noto Sans Bold
# Local self-hosted basemap built by the geodata agent (Abruzzo, z0–14):
#   NEXT_PUBLIC_PMTILES_URL=http://127.0.0.1:8088/abruzzo.pmtiles
#   NEXT_PUBLIC_MAP_GLYPHS_URL=http://127.0.0.1:8088/fonts/{fontstack}/{range}.pbf
#   NEXT_PUBLIC_MAP_FONT_BOLD=Noto Sans Medium
